{
  "name": "archeology-doc",
  "displayName": "Archeology Doc",
  "description": "%extension.description%",
  "version": "0.1.1",
  "publisher": "jcruz",
  "author": "jcruz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsoncr/archeology-doc"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "workspaceContains:**/archeology-doc.toml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces%"
    },
    "virtualWorkspaces": false
  },
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "archeology",
          "title": "%viewsContainer.archeology.title%",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "archeology": [
        {
          "id": "adoc.projects",
          "name": "%view.projects.name%"
        },
        {
          "id": "adoc.tasks",
          "name": "%view.tasks.name%"
        },
        {
          "id": "adoc.findings",
          "name": "%view.findings.name%"
        },
        {
          "id": "adoc.questions",
          "name": "%view.questions.name%"
        },
        {
          "id": "adoc.knowledge",
          "name": "%view.knowledge.name%"
        },
        {
          "id": "adoc.specs",
          "name": "%view.specs.name%",
          "when": "adoc.hasSpecs"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "adoc.tasks",
        "contents": "%viewsWelcome.tasks.noProject%",
        "when": "!adoc.hasProject"
      },
      {
        "view": "adoc.tasks",
        "contents": "%viewsWelcome.tasks.noTasks%",
        "when": "adoc.hasProject && !adoc.hasTasks"
      },
      {
        "view": "adoc.projects",
        "contents": "%viewsWelcome.projects.empty%"
      }
    ],
    "commands": [
      {
        "command": "adoc.dashboard",
        "title": "%command.dashboard.title%",
        "category": "adoc",
        "icon": "$(dashboard)"
      },
      {
        "command": "adoc.refresh",
        "title": "%command.refresh.title%",
        "category": "adoc",
        "icon": "$(refresh)"
      },
      {
        "command": "adoc.menu",
        "title": "%command.menu.title%",
        "category": "adoc"
      },
      {
        "command": "adoc.init",
        "title": "%command.init.title%",
        "category": "adoc"
      },
      {
        "command": "adoc.scan",
        "title": "%command.scan.title%",
        "category": "adoc"
      },
      {
        "command": "adoc.plan",
        "title": "%command.plan.title%",
        "category": "adoc"
      },
      {
        "command": "adoc.planForce",
        "title": "%command.planForce.title%",
        "category": "adoc"
      },
      {
        "command": "adoc.inspect",
        "title": "%command.inspect.title%",
        "category": "adoc",
        "icon": "$(play)"
      },
      {
        "command": "adoc.resume",
        "title": "%command.resume.title%",
        "category": "adoc",
        "icon": "$(debug-restart)"
      },
      {
        "command": "adoc.review",
        "title": "%command.review.title%",
        "category": "adoc"
      },
      {
        "command": "adoc.check",
        "title": "%command.check.title%",
        "category": "adoc"
      },
      {
        "command": "adoc.sync",
        "title": "%command.sync.title%",
        "category": "adoc"
      },
      {
        "command": "adoc.doctor",
        "title": "%command.doctor.title%",
        "category": "adoc"
      },
      {
        "command": "adoc.siteDev",
        "title": "%command.siteDev.title%",
        "category": "adoc"
      },
      {
        "command": "adoc.siteBuild",
        "title": "%command.siteBuild.title%",
        "category": "adoc"
      },
      {
        "command": "adoc.selectAgent",
        "title": "%command.selectAgent.title%",
        "category": "adoc",
        "icon": "$(hubot)"
      },
      {
        "command": "adoc.task.run",
        "title": "%command.task.run.title%",
        "category": "adoc",
        "icon": "$(play)"
      },
      {
        "command": "adoc.task.runInteractive",
        "title": "%command.task.runInteractive.title%",
        "category": "adoc",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "adoc.task.answer",
        "title": "%command.task.answer.title%",
        "category": "adoc",
        "icon": "$(reply)"
      },
      {
        "command": "adoc.task.done",
        "title": "%command.task.done.title%",
        "category": "adoc",
        "icon": "$(check)"
      },
      {
        "command": "adoc.task.openLog",
        "title": "%command.task.openLog.title%",
        "category": "adoc",
        "icon": "$(output)"
      },
      {
        "command": "adoc.task.copyCommand",
        "title": "%command.task.copyCommand.title%",
        "category": "adoc",
        "icon": "$(copy)"
      },
      {
        "command": "adoc.selectProject",
        "title": "%command.selectProject.title%",
        "category": "adoc",
        "icon": "$(folder-library)"
      },
      {
        "command": "adoc.openProjectFolder",
        "title": "%command.openProjectFolder.title%",
        "category": "adoc",
        "icon": "$(link-external)"
      },
      {
        "command": "adoc.preview",
        "title": "%command.preview.title%",
        "category": "adoc",
        "icon": "$(preview)"
      },
      {
        "command": "adoc.report",
        "title": "%command.report.title%",
        "category": "adoc",
        "icon": "$(file-code)"
      },
      {
        "command": "adoc.ask",
        "title": "%command.ask.title%",
        "category": "adoc",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "adoc.answerQuestion",
        "title": "%command.answerQuestion.title%",
        "category": "adoc"
      },
      {
        "command": "adoc.graph",
        "title": "%command.graph.title%",
        "category": "adoc",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "adoc.installTools",
        "title": "%command.installTools.title%",
        "category": "adoc",
        "icon": "$(desktop-download)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "adoc.dashboard",
          "when": "view == adoc.tasks || view == adoc.projects",
          "group": "navigation@0"
        },
        {
          "command": "adoc.inspect",
          "when": "view == adoc.tasks",
          "group": "navigation@1"
        },
        {
          "command": "adoc.resume",
          "when": "view == adoc.tasks",
          "group": "navigation@2"
        },
        {
          "command": "adoc.selectAgent",
          "when": "view == adoc.tasks",
          "group": "navigation@3"
        },
        {
          "command": "adoc.refresh",
          "when": "view =~ /^adoc\\./",
          "group": "navigation@9"
        },
        {
          "command": "adoc.planForce",
          "when": "view == adoc.tasks",
          "group": "1_plan"
        },
        {
          "command": "adoc.check",
          "when": "view == adoc.tasks",
          "group": "1_plan"
        },
        {
          "command": "adoc.doctor",
          "when": "view == adoc.tasks",
          "group": "1_plan"
        },
        {
          "command": "adoc.preview",
          "when": "view == adoc.tasks",
          "group": "navigation@4"
        },
        {
          "command": "adoc.ask",
          "when": "view == adoc.questions",
          "group": "navigation@1"
        },
        {
          "command": "adoc.graph",
          "when": "view == adoc.knowledge",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "adoc.task.run",
          "when": "view == adoc.tasks && viewItem =~ /^task\\.(pending|failed|manual|running|question)$/",
          "group": "inline@1"
        },
        {
          "command": "adoc.task.answer",
          "when": "view == adoc.tasks && viewItem == task.question",
          "group": "inline@0"
        },
        {
          "command": "adoc.task.run",
          "when": "view == adoc.tasks && viewItem =~ /^task\\./",
          "group": "1_run@1"
        },
        {
          "command": "adoc.task.runInteractive",
          "when": "view == adoc.tasks && viewItem =~ /^task\\./",
          "group": "1_run@2"
        },
        {
          "command": "adoc.task.answer",
          "when": "view == adoc.tasks && viewItem == task.question",
          "group": "1_run@3"
        },
        {
          "command": "adoc.task.done",
          "when": "view == adoc.tasks && viewItem =~ /^task\\.(pending|failed|manual|question|running)$/",
          "group": "2_state@1"
        },
        {
          "command": "adoc.task.openLog",
          "when": "view == adoc.tasks && viewItem =~ /^task\\./",
          "group": "3_info@1"
        },
        {
          "command": "adoc.task.copyCommand",
          "when": "view == adoc.tasks && viewItem =~ /^task\\./",
          "group": "3_info@2"
        },
        {
          "command": "adoc.openProjectFolder",
          "when": "view == adoc.projects && viewItem == project.external",
          "group": "inline@1"
        },
        {
          "command": "adoc.openProjectFolder",
          "when": "view == adoc.projects",
          "group": "1_open@1"
        }
      ],
      "commandPalette": [
        {
          "command": "adoc.task.run",
          "when": "false"
        },
        {
          "command": "adoc.task.runInteractive",
          "when": "false"
        },
        {
          "command": "adoc.task.answer",
          "when": "false"
        },
        {
          "command": "adoc.task.done",
          "when": "false"
        },
        {
          "command": "adoc.task.openLog",
          "when": "false"
        },
        {
          "command": "adoc.task.copyCommand",
          "when": "false"
        },
        {
          "command": "adoc.openProjectFolder",
          "when": "false"
        },
        {
          "command": "adoc.answerQuestion",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "archeologyDoc.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "es"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.en%",
            "%config.language.es%"
          ],
          "markdownDescription": "%config.language.description%"
        },
        "archeologyDoc.path": {
          "type": "string",
          "default": "",
          "description": "%config.path.description%",
          "scope": "machine"
        },
        "archeologyDoc.decorations": {
          "type": "boolean",
          "default": true,
          "description": "%config.decorations.description%"
        },
        "archeologyDoc.checkToolsOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "%config.checkToolsOnStartup.description%"
        },
        "archeologyDoc.downloadUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.downloadUrl.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && node scripts/copy-graph.js && tsc -p . && node scripts/check-i18n.js",
    "copy-graph": "node scripts/copy-graph.js",
    "watch": "tsc -watch -p .",
    "package": "vsce package --no-dependencies",
    "check-i18n": "node scripts/check-i18n.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
